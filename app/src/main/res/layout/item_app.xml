<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_app"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/banner_layout"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:transitionGroup="false"
        android:screenReaderFocusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <ImageView
            android:id="@+id/banner"
            android:duplicateParentState="true"
            android:layout_width="@dimen/app_banner_width_l"
            android:layout_height="@dimen/app_banner_height_l"
            android:scaleType="fitXY"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/icon"
        android:padding="@dimen/app_padding"
        android:duplicateParentState="true"
        android:layout_width="@dimen/app_icon_size_l"
        android:layout_height="@dimen/app_icon_size_l"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/banner_layout"
        app:layout_constraintEnd_toEndOf="@+id/banner_layout"
        app:layout_constraintStart_toStartOf="@+id/banner_layout"
        app:layout_constraintTop_toTopOf="@+id/banner_layout"/>
    <com.vctv.launcher.util.CustomTextView
        android:textSize="@dimen/app_label_size"
        android:textColor="@color/lb_action_text_color"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/label"
        android:layout_width="@dimen/dimension_zero"
        android:layout_height="@dimen/app_label_height"
        android:singleLine="true"
        android:marqueeRepeatLimit="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/banner_layout"
        app:layout_constraintTop_toBottomOf="@+id/banner_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
