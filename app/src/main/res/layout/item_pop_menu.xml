<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/menu_item"
    android:background="@color/move_button_enable_color"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="@dimen/pop_menu_width"
    android:layout_height="@dimen/pop_menu_height"
    android:screenReaderFocusable="true">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/pop_menu_icon_padding"
        android:focusable="false"
        android:layout_width="@dimen/dimension_zero"
        android:layout_height="@dimen/pop_menu_icon_container_height"
        android:layout_weight="1">
        <ImageView
            android:gravity="center"
            android:id="@+id/icon"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"/>
    </LinearLayout>
    <com.vctv.launcher.util.CustomTextView
        android:textSize="@dimen/pop_menu_text_size"
        android:textStyle="bold"
        android:textColor="@color/colorBlack"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/desc"
        android:layout_width="@dimen/dimension_zero"
        android:layout_height="@dimen/pop_menu_text_height"
        android:layout_weight="3"
        android:marqueeRepeatLimit="1"/>
</LinearLayout>
