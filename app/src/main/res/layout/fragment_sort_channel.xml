<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#1f1f1f"
        android:layout_width="@dimen/custom_channel_side_fragment_width"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true">
        <FrameLayout
            android:background="#131314"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:transitionGroup="false"
            android:elevation="@dimen/header_elevation">
            <com.vctv.launcher.util.CustomTextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="center_vertical"
                android:id="@+id/sort_channels_fragment_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/side_fragment_header_height"
                android:layout_marginTop="@dimen/side_fragment_header_margin_top"
                android:text="@string/sort_channel_fragment_title"
                android:maxLines="1"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginStart="@dimen/side_fragment_header_margin_start"
                android:layout_marginEnd="@dimen/side_fragment_header_margin_end"/>
        </FrameLayout>
        <View
            android:background="#333333"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"/>
        <com.vctv.launcher.util.CustomTextView
            android:textSize="@dimen/side_fragment_item_text_size"
            android:id="@+id/sort_channel_description"
            android:paddingTop="@dimen/sort_channel_description_padding_top"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/side_fragment_item_height"
            android:text="@string/sort_channel_fragment_description"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginStart="@dimen/side_fragment_header_margin_start"
            android:layout_marginEnd="@dimen/sort_channel_description_margin_end"/>
        <com.vctv.launcher.home.SortChannelVerticalGridView
            android:id="@+id/sort_channel_list"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <requestFocus/>
        </com.vctv.launcher.home.SortChannelVerticalGridView>
    </LinearLayout>
</FrameLayout>
