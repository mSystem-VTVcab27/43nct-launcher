<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/id_app_channel_info_view"
    android:background="@drawable/custom_channel_focus_background"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/side_fragment_item_height">
    <ImageView
        android:id="@+id/app_banner"
        android:background="@drawable/rounded_corner_bg"
        android:focusable="false"
        android:layout_width="@dimen/app_banner_width"
        android:layout_height="@dimen/app_banner_height"
        android:layout_marginLeft="@dimen/app_banner_margin_start"
        android:layout_centerVertical="true"/>
    <com.vctv.launcher.util.CustomTextView
        android:textSize="@dimen/app_name_text_size"
        android:textColor="@color/colorWhite"
        android:id="@+id/app_name"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/app_name_margin_start"
        android:layout_marginTop="@dimen/app_name_margin_top"
        android:layout_toRightOf="@+id/app_banner"/>
    <com.vctv.launcher.util.CustomTextView
        android:textSize="@dimen/app_channel_count_text_size"
        android:textColor="@color/colorWhite"
        android:id="@+id/app_channel_count"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/app_channel_count_margin_start"
        android:layout_marginBottom="@dimen/app_channel_count_margin_bottom"
        android:layout_toRightOf="@+id/app_banner"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_chevron_right_24"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/chevron_right_image_margin_end"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
