<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/id_custom_channel_entrance"
    android:focusable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/custom_channel_entrance_layout_margin_left"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="@dimen/custom_channel_entrance_layout_margin_bottom">
    <LinearLayout
        android:id="@+id/display_entrance_border_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/display_channel_entrance_layout"
            android:background="@drawable/custom_channel_entrance_selector"
            android:paddingLeft="@dimen/channel_entrance_padding_left"
            android:paddingTop="@dimen/channel_entrance_padding_top"
            android:focusable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="@dimen/channel_entrance_width"
            android:layout_height="@dimen/channel_entrance_height">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/display_channel_entrance_image"
                android:focusable="false"
                android:layout_width="@dimen/channel_entrance_icon_size"
                android:layout_height="@dimen/channel_entrance_icon_size"
                android:src="@drawable/baseline_display_settings"/>
            <com.vctv.launcher.util.CustomTextView
                android:textSize="@dimen/channel_entrance_title_text_size"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:id="@+id/display_channel_entrance_title"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/channel_entrance_title_margin_left"
                android:text="@string/display_channel_entrance_title"
                android:layout_toRightOf="@+id/display_channel_entrance_image"/>
            <com.vctv.launcher.util.CustomTextView
                android:textSize="@dimen/channel_entrance_desc_text_size"
                android:id="@+id/display_channel_entrance_description"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/channel_entrance_desc_margin_top"
                android:text="@string/display_channel_entrance_description"
                android:layout_below="@+id/display_channel_entrance_image"
                android:layout_marginEnd="@dimen/channel_entrance_desc_margin_end"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sort_entrance_border_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sort_entrance_item_margin_left">
        <RelativeLayout
            android:id="@+id/sort_channel_entrance_layout"
            android:background="@drawable/custom_channel_entrance_selector"
            android:paddingLeft="@dimen/channel_entrance_padding_left"
            android:paddingTop="@dimen/channel_entrance_padding_top"
            android:focusable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="@dimen/channel_entrance_width"
            android:layout_height="@dimen/channel_entrance_height">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sort_channel_entrance_image"
                android:focusable="false"
                android:layout_width="@dimen/channel_entrance_icon_size"
                android:layout_height="@dimen/channel_entrance_icon_size"
                android:src="@drawable/baseline_sort"/>
            <com.vctv.launcher.util.CustomTextView
                android:textSize="@dimen/channel_entrance_title_text_size"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:id="@+id/sort_channel_entrance_title"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/channel_entrance_title_margin_left"
                android:text="@string/sort_channel_entrance_title"
                android:layout_toRightOf="@+id/sort_channel_entrance_image"/>
            <com.vctv.launcher.util.CustomTextView
                android:textSize="@dimen/channel_entrance_desc_text_size"
                android:id="@+id/sort_channel_entrance_description"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/channel_entrance_desc_margin_top"
                android:text="@string/sort_channel_entrance_description"
                android:layout_below="@+id/sort_channel_entrance_image"
                android:layout_marginEnd="@dimen/channel_entrance_desc_margin_end"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
