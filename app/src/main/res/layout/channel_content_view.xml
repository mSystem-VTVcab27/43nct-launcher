<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/id_channel_content_view"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes"
    android:screenReaderFocusable="true">
    <com.vctv.launcher.util.CustomTextView
        android:textSize="@dimen/channel_title_text_size"
        android:ellipsize="end"
        android:id="@+id/channel_title"
        
        android:focusable="false"
        android:layout_width="@dimen/channel_content_view_text_width"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:importantForAccessibility="yes"
        android:layout_marginStart="@dimen/channel_content_view_margin_start"
        android:screenReaderFocusable="true"/>
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/program_horizontal_grid_view"
        android:paddingTop="@dimen/program_grid_padding_top"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/program_grid_height"
        android:layout_marginStart="@dimen/channel_content_view_margin_start"/>
    <com.vctv.launcher.util.CustomTextView
        android:textSize="@dimen/program_item_text_size"
        android:textStyle="bold"
        android:ellipsize="end"
        android:id="@+id/program_item_title"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="@dimen/channel_content_view_text_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/program_item_title_margin_top"
        android:maxLines="1"
        android:layout_marginStart="@dimen/channel_content_view_margin_start"
        android:screenReaderFocusable="false"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/program_description_layout"
        android:visibility="gone"
        android:layout_width="@dimen/program_description_layout_width"
        android:layout_height="@dimen/program_description_layout_height"
        android:layout_marginTop="@dimen/program_description_layout_margin_top">
        <com.vctv.launcher.util.CustomTextView
            android:textSize="@dimen/program_description_text_size"
            android:ellipsize="end"
            android:id="@+id/program_item_first_description"
            android:focusable="false"
            android:layout_width="@dimen/channel_content_view_text_width"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/channel_content_view_margin_start"
            android:screenReaderFocusable="false"/>
        <com.vctv.launcher.util.CustomTextView
            android:textSize="@dimen/program_description_text_size"
            android:ellipsize="end"
            android:id="@+id/program_item_second_description"
            android:focusable="false"
            android:layout_width="@dimen/channel_content_view_text_width"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/program_description_margin_top"
            android:maxLines="1"
            android:layout_marginStart="@dimen/channel_content_view_margin_start"
            android:screenReaderFocusable="false"/>
    </LinearLayout>
</LinearLayout>
