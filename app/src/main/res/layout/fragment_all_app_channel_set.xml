<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#1f1f1f"
        android:layout_width="@dimen/custom_channel_side_fragment_width"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true">
        <FrameLayout
            android:background="#131314"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:transitionGroup="false"
            android:elevation="@dimen/header_elevation">
            <com.vctv.launcher.util.CustomTextView
                android:textSize="@dimen/side_fragment_header_text_size"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="center_vertical"
                android:id="@+id/channel_set_fragment_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/side_fragment_header_height"
                android:layout_marginTop="@dimen/side_fragment_header_margin_top"
                android:text="@string/all_app_channel_set_fragment_title"
                android:maxLines="1"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginStart="@dimen/side_fragment_header_margin_start"
                android:layout_marginEnd="@dimen/side_fragment_header_margin_end"/>
        </FrameLayout>
        <View
            android:background="#333333"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"/>
        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/app_channel_list"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <requestFocus/>
        </androidx.leanback.widget.VerticalGridView>
    </LinearLayout>
</FrameLayout>
