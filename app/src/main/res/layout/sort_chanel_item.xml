<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/custom_channel_focus_background"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/side_fragment_item_height">
    <com.vctv.launcher.util.CustomTextView
        android:textSize="@dimen/sort_item_name_text_size"
        android:ellipsize="end"
        android:id="@+id/channel_name"
        android:focusable="false"
        android:layout_width="@dimen/sort_item_name_width"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sort_item_name_margin_start"
        android:maxLines="1"
        android:layout_centerVertical="true"/>
    <com.vctv.launcher.util.CustomTextView
        android:textSize="@dimen/side_fragment_item_desc_text_size"
        android:textColor="@color/not_focusable"
        android:id="@+id/preset_channel_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/channel_desc_margin_start"
        android:text="@string/preset_channel_description_on_sort_fragment"
        android:maxLines="1"
        android:layout_below="@+id/channel_name"/>
    <ImageView
        android:id="@+id/sort_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/sort_image_margin_end"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
