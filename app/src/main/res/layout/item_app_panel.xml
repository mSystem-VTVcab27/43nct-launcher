<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/custom_channel_focus_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_panel_item_height"
    android:screenReaderFocusable="true">
    <LinearLayout
        android:gravity="center"
        android:focusable="false"
        android:layout_width="@dimen/dimension_zero"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:paddingStart="@dimen/app_panel_item_padding_start">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/banner"
                android:padding="@dimen/app_panel_banner_padding"
                android:duplicateParentState="true"
                android:layout_width="@dimen/app_panel_banner_width"
                android:layout_height="@dimen/app_panel_banner_height"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"/>
            <ImageView
                android:id="@+id/icon"
                android:padding="@dimen/app_panel_icon_padding"
                android:duplicateParentState="true"
                android:layout_width="@dimen/app_panel_icon_size"
                android:layout_height="@dimen/app_panel_icon_size"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="@+id/banner"
                app:layout_constraintEnd_toEndOf="@+id/banner"
                app:layout_constraintStart_toStartOf="@+id/banner"
                app:layout_constraintTop_toTopOf="@+id/banner"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <com.vctv.launcher.util.CustomTextView
        android:textSize="@dimen/app_panel_text_size"
        android:textColor="@color/lb_action_text_color"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/label"
        android:focusable="false"
        android:layout_width="@dimen/dimension_zero"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:layout_weight="4"
        android:marqueeRepeatLimit="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/banner"
        app:layout_constraintTop_toBottomOf="@+id/banner"/>
</LinearLayout>
