<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:screenReaderFocusable="true">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/move_up_layout"
        android:background="#fafbff"
        android:focusable="true"
        android:layout_width="@dimen/move_button_width"
        android:layout_height="@dimen/move_button_height"
        android:importantForAccessibility="yes"
        android:screenReaderFocusable="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:focusable="false"
            android:layout_width="@dimen/move_icon_size"
            android:layout_height="@dimen/move_icon_size"
            android:src="@drawable/drop_up_circle"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/move_icon_margin_start"/>
        <com.vctv.launcher.util.CustomTextView
            android:textSize="@dimen/move_text_size"
            android:textStyle="bold"
            android:textColor="@color/colorBlack"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/move_text_height"
            android:text="@string/move_up_button"
            android:layout_weight="3"
            android:marqueeRepeatLimit="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/move_text_margin_start"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/move_down_layout"
        android:background="#fafbff"
        android:focusable="true"
        android:layout_width="@dimen/move_button_width"
        android:layout_height="@dimen/move_button_height"
        android:importantForAccessibility="yes"
        android:layout_marginStart="@dimen/move_button_margin_start"
        android:screenReaderFocusable="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:focusable="false"
            android:layout_width="@dimen/move_icon_size"
            android:layout_height="@dimen/move_icon_size"
            android:src="@drawable/drop_down_circle"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/move_icon_margin_start"/>
        <com.vctv.launcher.util.CustomTextView
            android:textSize="@dimen/move_text_size"
            android:textStyle="bold"
            android:textColor="@color/colorBlack"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/move_text_height"
            android:text="@string/move_down_button"
            android:layout_weight="3"
            android:marqueeRepeatLimit="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/move_text_margin_start"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/move_done_layout"
        android:background="#fafbff"
        android:focusable="true"
        android:layout_width="@dimen/move_button_width"
        android:layout_height="@dimen/move_button_height"
        android:importantForAccessibility="yes"
        android:layout_marginStart="@dimen/move_button_margin_start"
        android:screenReaderFocusable="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:focusable="false"
            android:layout_width="@dimen/move_icon_size"
            android:layout_height="@dimen/move_icon_size"
            android:src="@drawable/move_done"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/move_icon_margin_start"/>
        <com.vctv.launcher.util.CustomTextView
            android:textSize="@dimen/move_text_size"
            android:textStyle="bold"
            android:textColor="@color/colorBlack"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/move_text_height"
            android:text="@string/move_done_button"
            android:layout_weight="3"
            android:marqueeRepeatLimit="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/move_text_margin_start"/>
    </LinearLayout>
</LinearLayout>
