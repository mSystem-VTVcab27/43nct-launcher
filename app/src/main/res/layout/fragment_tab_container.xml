<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/container_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/container_margin_top"
        android:paddingStart="@dimen/container_padding_start"
        android:paddingEnd="@dimen/dimension_zero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/logo_width"
            android:layout_height="@dimen/logo_height"
            android:src="@drawable/default_logo"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/default_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vctv.launcher.tab.view.LeanbackTab
            android:id="@+id/tab_layout"
            android:layout_width="@dimen/dimension_zero"
            android:layout_height="@dimen/tab_height"
            android:layout_marginStart="@dimen/tab_margin_start"
            app:layout_constraintStart_toEndOf="@+id/logo"
            app:layout_constraintTop_toTopOf="parent"
            app:tabContentStart="@dimen/tab_content_start"
            app:tabGravity="start"
            app:tabIndicatorColor="@android:color/white"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="@dimen/tab_indicator_height"
            app:tabMaxWidth="@dimen/tab_max_width"
            app:tabMode="auto"
            app:tabRippleColor="@android:color/transparent"
            app:tabTextAppearance="@style/LeanBackTabTextAppearance"
            app:tabTextColor="@drawable/tab_font_color_selector"/>
        <com.vctv.launcher.tab.view.NotificationItem
            android:gravity="center"
            android:id="@+id/notification"
            android:visibility="gone"
            android:padding="@dimen/notification_padding"
            android:focusable="true"
            android:layout_width="@dimen/notification_width"
            android:layout_height="@dimen/notification_height"
            android:hint="@string/notification"
            app:layout_constraintBottom_toBottomOf="@+id/settings"
            app:layout_constraintEnd_toStartOf="@+id/settings"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.vctv.launcher.tab.view.IconNavButton
            android:id="@+id/settings"
            android:padding="@dimen/settings_padding"
            android:focusable="true"
            android:layout_width="@dimen/settings_width"
            android:layout_height="@dimen/settings_height"
            android:contentDescription="@string/setting"
            android:layout_marginEnd="@dimen/settings_margin_end"
            app:layout_constraintEnd_toStartOf="@+id/clock"
            app:layout_constraintTop_toTopOf="parent"
            app:src="@drawable/ic_setting"/>
        <TextClock
            android:textSize="@dimen/clock_text_size"
            android:textColor="#a6a6a6"
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/clock_margin_start"
            android:layout_marginEnd="@dimen/clock_margin_end"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:layout_marginHorizontal="@dimen/clock_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:paddingTop="@dimen/hint_info_padding_top"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container_layout">
        <com.vctv.launcher.util.CustomTextView
            android:textSize="@dimen/hint_info_text_size"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/tv_hint_info"
            android:layout_width="@dimen/hint_info_width"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <androidx.leanback.tab.LeanbackViewPager
        android:id="@+id/content_view_page"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="@dimen/content_view_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
